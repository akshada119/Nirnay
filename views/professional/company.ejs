<%- layout("layout/boilerplate") %>

<div class="company-page">


<div class="company-form-card">

    <div class="company-form-header">

        <span class="company-form-label">
            PROFESSIONAL PROFILE
        </span>

        <h2>Create Your Company</h2>

        <p>
            Add your company details so customers can discover your services.
        </p>

    </div>


    <form action="/professional/company" method="POST" id="createCompanyForm"     class="nirnay-validation-form" novalidate>

        <div class="row">


            <!-- Company Name -->
            <div class="col-md-6 mb-3">
                <label class="company-form-label-text">
                    Company Name
                </label>

                <input
                    type="text"
                    name="name"
                    class="company-input"
                    placeholder="Enter company name"
                    required
                    minlength="2"
                    maxlength="150" 
                       data-validation="company-name">

            </div>


            <!-- Category -->
            <div class="col-md-6 mb-3">

                <label class="company-form-label-text">
                    Consultancy Category
                </label>

                <select
                    name="category"
                    class="company-select"
                    required>

                    <option value="" disabled selected>
                        Select Category
                    </option>

                    <option value="IT">IT</option>
                    <option value="Finance">Finance</option>
                    <option value="Healthcare">Healthcare</option>
                    <option value="Education">Education</option>
                    <option value="Business">Business</option>
                    <option value="HR">HR</option>
                    <option value="Legal">Legal</option>
                    <option value="Marketing">Marketing</option>
                    <option value="Career">Career</option>
                    <option value="Agriculture">Agriculture</option>
                    <option value="Real Estate">Real Estate</option>
                    <option value="Engineering">Engineering</option>
                    <option value="Manufacturing">Manufacturing</option>
                    <option value="Environmental">Environmental</option>
                    <option value="Research">Research</option>

                </select>

            </div>


            <!-- Description -->
            <div class="col-12 mb-3">

                <label class="company-form-label-text">
                    Company Description
                </label>

                <textarea
                    name="description"
                    class="company-textarea"
                    rows="4"
                    placeholder="Describe your company and services..."
                    required
                    minlength="10"
                    maxlength="2000"></textarea>

            </div>


            <!-- Email -->
            <div class="col-md-6 mb-3">

                <label class="company-form-label-text">
                    Company Email
                </label>

                <input
                    type="email"
                    name="email"
                    class="company-input"
                    placeholder="company@example.com"
                    required
                    maxlength="100">

            </div>


            <!-- Mobile -->
            <div class="col-md-6 mb-3">

                <label class="company-form-label-text">
                    Mobile Number
                </label>

                <input
                    type="text"
                    name="mobile"
                    class="company-input"
                    placeholder="Enter mobile number"
                    required
                    minlength="10"
                    maxlength="10"
                    pattern="[6-9][0-9]{9}"
                    title="Enter a valid 10-digit Indian mobile number starting with 6, 7, 8, or 9.">

            </div>


            <!-- Address -->
            <div class="col-md-8 mb-3">

                <label class="company-form-label-text">
                    Address
                </label>

                <input
                    type="text"
                    name="address"
                    class="company-input"
                    placeholder="Enter company address"
                    required
                    minlength="5"
                    maxlength="250">

            </div>


            <!-- City -->
            <div class="col-md-4 mb-3">

                <label class="company-form-label-text">
                    City
                </label>

                <input
                    type="text"
                    name="city"
                    class="company-input"
                    placeholder="Enter city"
                    required
                    minlength="2"
                    maxlength="100"
                    pattern="[A-Za-zÀ-ÖØ-öø-ÿ\s.'-]{2,100}"
                    title="City should contain only letters, spaces, apostrophes, dots, or hyphens.">

            </div>


            <!-- Website -->
            <div class="col-12 mb-4">

                <label class="company-form-label-text">
                    Website
                </label>

                <input
                    type="url"
                    name="website"
                    class="company-input"
                    placeholder="https://example.com"
                    maxlength="255">

            </div>


            <!-- Submit -->
            <div class="col-12 text-center">

                <button
                    type="submit"
                    class="company-submit-btn">

                    Create Company

                </button>

            </div>

        </div>

    </form>

</div>


</div>

<script>

    const createCompanyForm =
        document.getElementById("createCompanyForm");

    const companyMobileInput =
        createCompanyForm.querySelector('input[name="mobile"]');


    /*
     * Allow only digits in mobile number
     */
    companyMobileInput.addEventListener("input", function () {

        this.value = this.value.replace(/\D/g, "").slice(0, 10);

    });

</script>

<script src="/js/nirnay-validation.js"></script>
