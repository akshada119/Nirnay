<%- layout("layout/adminLayout") %>

    <div class="professional-dashboard">

        <!-- ==========================================
         HEADER
    =========================================== -->

        <div class="dashboard-header">

            <div>

                <span class="dashboard-label">
                    BOOKING DETAILS
                </span>

                <h1>
                    Booking Information
                </h1>

                <p>
                    View complete information about this
                    customer booking.
                </p>

            </div>


            <div class="dashboard-badge">

                <i class="fa-solid fa-calendar-check"></i>

                <%= booking.status %>

            </div>

        </div>


        <!-- ==========================================
         BACK
    =========================================== -->

        <a href="/admin/bookings" class="admin-back-link">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Bookings

        </a>


        <!-- ==========================================
         BOOKING OVERVIEW
    =========================================== -->

        <div class="admin-booking-overview">

            <div>

                <span class="admin-detail-label">
                    BOOKING STATUS
                </span>

                <span class="admin-status status-<%= booking.status %>">

                    <%= booking.status %>

                </span>

            </div>


            <div>

                <span class="admin-detail-label">
                    BOOKING DATE
                </span>

                <strong>

                    <%= booking.bookingDate ? new Date( booking.bookingDate ).toLocaleDateString("en-IN", {
                        day: "2-digit" , month: "long" , year: "numeric" }) : "N/A" %>

                </strong>

            </div>


            <div>

                <span class="admin-detail-label">
                    CREATED ON
                </span>

                <strong>

                    <%= booking.createdAt ? new Date( booking.createdAt ).toLocaleDateString("en-IN") : "N/A" %>

                </strong>

            </div>

        </div>


        <!-- ==========================================
         CUSTOMER + SERVICE
    =========================================== -->

        <div class="admin-details-grid">


            <!-- CUSTOMER -->

            <div class="admin-detail-card">

                <div class="admin-detail-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <span class="admin-detail-label">
                    CUSTOMER
                </span>


                <% if (booking.customer) { %>

                    <h3>
                        <%= booking.customer.name %>
                    </h3>


                    <div class="admin-detail-list">


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-envelope"></i>

                            <div>

                                <span>Email</span>

                                <strong>
                                    <%= booking.customer.email %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-phone"></i>

                            <div>

                                <span>Mobile</span>

                                <strong>
                                    <%= booking.customer.mobile || "Not provided" %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-location-dot"></i>

                            <div>

                                <span>Address</span>

                                <strong>
                                    <%= booking.customer.address || "Not provided" %>
                                </strong>

                            </div>

                        </div>

                    </div>


                    <% } else { %>

                        <div class="admin-company-empty">

                            <div class="admin-empty-icon">

                                <i class="fa-solid fa-user-xmark"></i>

                            </div>

                            <h3>
                                Customer Unavailable
                            </h3>

                            <p>
                                The customer associated with
                                this booking is no longer available.
                            </p>

                        </div>

                        <% } %>

            </div>


            <!-- SERVICE -->

            <div class="admin-detail-card">

                <div class="admin-detail-icon">

                    <i class="fa-solid fa-briefcase"></i>

                </div>

                <span class="admin-detail-label">
                    SERVICE
                </span>


                <% if (booking.service) { %>

                    <h3>
                        <%= booking.service.name %>
                    </h3>


                    <div class="admin-detail-list">


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-layer-group"></i>

                            <div>

                                <span>Category</span>

                                <strong>
                                    <%= booking.service.category || "Not specified" %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-indian-rupee-sign"></i>

                            <div>

                                <span>Price</span>

                                <strong>
                                    ₹<%= booking.service.price || 0 %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-clock"></i>

                            <div>

                                <span>Duration</span>

                                <strong>
                                    <%= booking.service.duration || "Not specified" %>
                                </strong>

                            </div>

                        </div>

                    </div>


                    <% } else { %>

                        <div class="admin-company-empty">

                            <div class="admin-empty-icon">

                                <i class="fa-solid fa-briefcase"></i>

                            </div>

                            <h3>
                                Service Unavailable
                            </h3>

                            <p>
                                The service associated with
                                this booking is no longer available.
                            </p>

                        </div>

                        <% } %>

            </div>

        </div>


        <!-- ==========================================
         PROFESSIONAL + COMPANY
    =========================================== -->

        <div class="admin-details-grid">


            <!-- PROFESSIONAL -->

            <div class="admin-detail-card">

                <div class="admin-detail-icon">

                    <i class="fa-solid fa-user-tie"></i>

                </div>

                <span class="admin-detail-label">
                    PROFESSIONAL
                </span>


                <% if (booking.professional) { %>

                    <h3>
                        <%= booking.professional.name %>
                    </h3>


                    <div class="admin-detail-list">


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-envelope"></i>

                            <div>

                                <span>Email</span>

                                <strong>
                                    <%= booking.professional.email %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-phone"></i>

                            <div>

                                <span>Mobile</span>

                                <strong>
                                    <%= booking.professional.mobile || "Not provided" %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-briefcase"></i>

                            <div>

                                <span>Consultancy</span>

                                <strong>
                                    <%= booking.professional.consultancy || "Not specified" %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-award"></i>

                            <div>

                                <span>Experience</span>

                                <strong>
                                    <%= booking.professional.experience || "Not specified" %>
                                </strong>

                            </div>

                        </div>

                    </div>


                    <% } else { %>

                        <div class="admin-company-empty">

                            <div class="admin-empty-icon">

                                <i class="fa-solid fa-user-xmark"></i>

                            </div>

                            <h3>
                                Professional Unavailable
                            </h3>

                            <p>
                                The professional associated with
                                this booking is no longer available.
                            </p>

                        </div>

                        <% } %>

            </div>


            <!-- COMPANY -->

            <div class="admin-detail-card">

                <div class="admin-detail-icon">

                    <i class="fa-solid fa-building"></i>

                </div>

                <span class="admin-detail-label">
                    COMPANY
                </span>


                <% if (booking.company) { %>

                    <h3>
                        <%= booking.company.name %>
                    </h3>


                    <div class="admin-detail-list">


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-layer-group"></i>

                            <div>

                                <span>Category</span>

                                <strong>
                                    <%= booking.company.category %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-envelope"></i>

                            <div>

                                <span>Email</span>

                                <strong>
                                    <%= booking.company.email %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-phone"></i>

                            <div>

                                <span>Mobile</span>

                                <strong>
                                    <%= booking.company.mobile %>
                                </strong>

                            </div>

                        </div>


                        <div class="admin-detail-row">

                            <i class="fa-solid fa-location-dot"></i>

                            <div>

                                <span>Location</span>

                                <strong>
                                    <%= booking.company.city %>
                                </strong>

                            </div>

                        </div>

                    </div>


                    <% } else { %>

                        <div class="admin-company-empty">

                            <div class="admin-empty-icon">

                                <i class="fa-solid fa-building-circle-xmark"></i>

                            </div>

                            <h3>
                                Company Unavailable
                            </h3>

                            <p>
                                No company is currently associated
                                with this booking.
                            </p>

                        </div>

                        <% } %>

            </div>

        </div>


        <!-- ==========================================
         CUSTOMER MESSAGE
    =========================================== -->

        <div class="admin-description-card">

            <div class="admin-description-icon">

                <i class="fa-solid fa-message"></i>

            </div>

            <div>

                <span class="admin-detail-label">
                    CUSTOMER MESSAGE
                </span>

                <h3>
                    Booking Request
                </h3>

                <p>

                    <%= booking.message || "No message was provided by the customer." %>

                </p>

            </div>

        </div>


        <!-- ==========================================
     STATUS MANAGEMENT
=========================================== -->

        <div class="admin-status-management">

            <div>

                <span class="admin-detail-label">
                    BOOKING STATUS
                </span>

                <h3>
                    Update Booking Status
                </h3>

                <p>
                    Change the current status of this booking.
                </p>

            </div>


            <form action="/admin/bookings/<%= booking._id %>/status" method="POST" class="admin-status-form    nirnay-validation-form" novalidate>

                <select name="status" class="admin-status-select" <%=["completed", "cancelled"
                    ].includes(booking.status) ? "disabled" : "" %>
                    >

                    <option value="pending" <%=booking.status==="pending" ? "selected" : "" %>
                        >
                        Pending
                    </option>

                    <option value="confirmed" <%=booking.status==="confirmed" ? "selected" : "" %>
                        >
                        Confirmed
                    </option>

                    <option value="completed" <%=booking.status==="completed" ? "selected" : "" %>
                        >
                        Completed
                    </option>

                    <option value="cancelled" <%=booking.status==="cancelled" ? "selected" : "" %>
                        >
                        Cancelled
                    </option>

                </select>


                <% if ( booking.status !=="completed" && booking.status !=="cancelled" ) { %>

                    <button type="submit" class="admin-status-update-btn">

                        <i class="fa-solid fa-check"></i>

                        Update Status

                    </button>

                    <% } else { %>

                        <span class="admin-status-locked">

                            <i class="fa-solid fa-lock"></i>

                            Status Locked

                        </span>

                        <% } %>

            </form>

        </div>

      <script src="/js/nirnay-validation.js"></script>