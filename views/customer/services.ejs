<%- layout("layout/boilerplate") %>

    <div class="container py-5 services-page">

        <!-- HEADER -->
        <div class="services-header text-center mb-5">
            <span class="services-label">NIRNAY SERVICES</span>

            <h1>
                Find the right
                <span>consultancy</span>
            </h1>

            <p class="text-muted">
                Explore professional consultancy categories and find
                the right expertise for your needs.
            </p>
        </div>

        <!-- =========================
         CONSULTANCY CATEGORIES
    ========================== -->

        <div class="text-center mb-4">
            <h2 class="service-class">Consultancy Categories</h2>
            <p class="text-muted">
                Choose an industry to explore expert consultancy.
            </p>
        </div>


        <div class="row g-4 mb-5">

            <!-- IT -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-laptop-code"></i>
                    </div>

                    <h4>IT Consultancy</h4>

                    <p>
                        Technology, software development, digital
                        transformation and IT solutions.
                    </p>

                    <a href="/consultancy/it">
                        Explore IT
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- FINANCE -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-coins"></i>
                    </div>

                    <h4>Finance Consultancy</h4>

                    <p>
                        Financial planning, investment, budgeting
                        and professional financial guidance.
                    </p>

                    <a href="/consultancy/finance">
                        Explore Finance
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- HEALTHCARE -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>

                    <h4>Healthcare Consultancy</h4>

                    <p>
                        Healthcare planning, management, medical
                        guidance and professional support.
                    </p>

                    <a href="/consultancy/healthcare">
                        Explore Healthcare
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- EDUCATION -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>

                    <h4>Education Consultancy</h4>

                    <p>
                        Academic guidance, career planning,
                        admissions and educational support.
                    </p>

                    <a href="/consultancy/education">
                        Explore Education
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- RESEARCH -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-flask"></i>
                    </div>

                    <h4>Research Consultancy</h4>

                    <p>
                        Research planning, analysis, methodology
                        and professional research assistance.
                    </p>

                    <a href="/consultancy/research">
                        Explore Research
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- BUSINESS -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>

                    <h4>Business Consultancy</h4>

                    <p>
                        Business strategy, operations, growth,
                        planning and performance improvement.
                    </p>

                    <a href="/consultancy/business">
                        Explore Business
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- HR -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <h4>HR Consultancy</h4>

                    <p>
                        Recruitment, employee management,
                        HR strategy and workplace solutions.
                    </p>

                    <a href="/consultancy/hr">
                        Explore HR
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- LEGAL -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>

                    <h4>Legal Consultancy</h4>

                    <p>
                        Legal guidance, documentation, compliance
                        and professional legal support.
                    </p>

                    <a href="/consultancy/legal">
                        Explore Legal
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- AGRICULTURE -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-wheat-awn"></i>
                    </div>

                    <h4>Agriculture Consultancy</h4>

                    <p>
                        Agricultural planning, crop management,
                        farming and modern agriculture solutions.
                    </p>

                    <a href="/consultancy/agriculture">
                        Explore Agriculture
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- MANUFACTURING -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-industry"></i>
                    </div>

                    <h4>Manufacturing Consultancy</h4>

                    <p>
                        Production planning, process improvement,
                        quality and manufacturing solutions.
                    </p>

                    <a href="/consultancy/manufacturing">
                        Explore Manufacturing
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- REAL ESTATE -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-building"></i>
                    </div>

                    <h4>Real Estate Consultancy</h4>

                    <p>
                        Property guidance, real estate planning,
                        investment and property solutions.
                    </p>

                    <a href="/consultancy/realEstate">
                        Explore Real Estate
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- MARKETING -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-bullhorn"></i>
                    </div>

                    <h4>Marketing Consultancy</h4>

                    <p>
                        Marketing strategy, branding, digital
                        marketing and business promotion.
                    </p>

                    <a href="/consultancy/marketing">
                        Explore Marketing
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- CAREER -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>

                    <h4>Career Consultancy</h4>

                    <p>
                        Career planning, job guidance, skill
                        development and professional growth.
                    </p>

                    <a href="/consultancy/career">
                        Explore Career
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- ENVIRONMENTAL -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-leaf"></i>
                    </div>

                    <h4>Environmental Consultancy</h4>

                    <p>
                        Environmental planning, sustainability,
                        compliance and eco-friendly solutions.
                    </p>

                    <a href="/consultancy/environmental">
                        Explore Environmental
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>


            <!-- ENGINEERING -->
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="category-card h-100">
                    <div class="category-icon">
                        <i class="fa-solid fa-gears"></i>
                    </div>

                    <h4>Engineering Consultancy</h4>

                    <p>
                        Engineering design, technical planning,
                        project support and expert solutions.
                    </p>

                    <a href="/consultancy/engineering">
                        Explore Engineering
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>

        </div>


        <!-- =========================
         PROFESSIONAL SERVICES
    ========================== -->

        <div class="professional-services-section mt-5">

            <div class="text-center mb-5">

                <span class="services-label">
                    PROFESSIONAL SERVICES
                </span>

                <h2>Available Services</h2>

                <p class="text-muted">
                    Services offered by professionals on Nirnay.
                </p>

            </div>

            <% if (services.length===0) { %>

          
                <div class="text-center py-5">

                    <i class="fa-solid fa-user-tie fa-3x mb-3"></i>

                    <h3>No professional services yet</h3>

                    <p class="text-muted">
                        Professionals will add their services here.
                    </p>

                </div>
            

                <% } else { %>

                    <div class="row g-4">

                        <% services.forEach((service, index)=> { %>

                            <div class="col-12 col-md-6 col-lg-4">

                                <div class="customer-service-card h-100">

                                    <% if (service.priorityImage && service.priorityImage.url) { %>

                                        <img src="<%= service.priorityImage.url %>" alt="<%= service.name %>"
                                            class="customer-service-card-image">

                                        <% } %>


                                            <div class="service-card-top">

                                                <span class="service-category">
                                                    <%= service.category %>
                                                </span>

                                                <span class="service-number">
                                                    <%= String(index + 1).padStart(2, "0" ) %>
                                                </span>

                                            </div>


                                            <h3>
                                                <%= service.name %>
                                            </h3>


                                            <p class="service-description">
                                                <%= service.description %>
                                            </p>


                                            <div class="service-info">

                                                <div>

                                                    <small>Price</small>

                                                    <strong>
                                                        ₹<%= service.price %>
                                                    </strong>

                                                </div>


                                                <div>

                                                    <small>Duration</small>

                                                    <strong>
                                                        <%= service.duration %>
                                                    </strong>

                                                </div>

                                            </div>


                                            <% if (service.company) { %>

                                                <div class="service-company">

                                                    <i class="fa-solid fa-building"></i>

                                                    <span>
                                                        <%= service.company.name %>
                                                    </span>

                                                </div>

                                                <% } %>


                                                    <a href="/services/<%= service.slug %>" class="view-service-btn">
                                                        View Details
                                                        <i class="fa-solid fa-arrow-right"></i>
                                                    </a>

                                </div>

                            </div>

                            <% }) %>

                    </div>
                   

                    <% } %>


        </div>

    </div>